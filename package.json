{
  "name": "grow-fish-wechat-minigame",
  "version": "0.1.0",
  "private": true,
  "description": "大鱼吃小鱼微信小游戏 V0.1",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:wechat": "node scripts/build.mjs --wechat",
    "build:web": "node scripts/build.mjs --web",
    "build:release": "node scripts/build.mjs --release",
    "preview:web": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.js",
    "test:core": "node --test tests/core.test.js",
    "smoke:wechat": "node scripts/wechat-bundle-smoke.mjs",
    "smoke:wechat:release": "node scripts/wechat-bundle-smoke.mjs --release",
    "verify": "npm test && npm run build && npm run smoke:wechat"
  },
  "engines": {
    "node": ">=22.23.0"
  },
  "devDependencies": {
    "esbuild": "0.25.0"
  }
}
